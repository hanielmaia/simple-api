{
  "ingress": [
    {
      "description": "Allow HTTP from internet",
      "from_port": 80,
      "to_port": 80,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    }
  ],
  "egress": [
    {
      "description": "Allow traffic to the application port inside the VPC only",
      "from_port": 3000,
      "to_port": 3000,
      "protocol": "tcp",
      "cidr_blocks": ["${VPC_CIDR}"]
    }
  ]
}
